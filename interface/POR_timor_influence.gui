guiTypes = {
	# Sits on top of the "Solor and Timor Archipelago" decision category.
	# Map offsets come straight from the province bitmap, so each area is drawn on
	# its real coastline. Content stays inside 490px, the width a category panel gets.
	# Driven by common/scripted_guis/POR_scripted_gui.txt.
	containerWindowType = {
		name = "POR_timor_influence_container"
		position = { x = 0 y = 0 }
		size = { width = 100% height = 292 }
		margin = { top = 0 bottom = 0 left = 0 right = 0 }

		containerWindowType = {
			name = "POR_timor_influence_bg"
			position = { x = 4 y = 0 }
			size = { width = 482 height = 288 }
			background = {
				name = "Background"
				spriteType = "GFX_tiled_plain_bg_small"
			}
			clipping = yes
		}

		instantTextboxType = {
			name = "POR_timor_influence_title"
			position = { x = 16 y = 4 }
			maxWidth = 454
			maxHeight = 20
			fixedsize = yes
			font = "hoi_18mbs"
			text = "POR_timor_influence_title_tt"
			format = left
			vertical_alignment = center
			alwaystransparent = yes
		}

		containerWindowType = {
			name = "POR_timor_map"
			position = { x = 26 y = 26 }
			size = { width = 432 height = 174 }

			background = {
				name = "POR_timor_map_bg"
				spriteType = "GFX_POR_timor_map_bg"
				alwaystransparent = yes
			}

			buttonType = {
				name = "POR_timor_area_west_sunda"
				position = { x = 22 y = 56 }
				spriteType = "GFX_POR_timor_area_west_sunda"
				pdx_tooltip = "POR_timor_area_west_sunda_tt"
			}
			buttonType = {
				name = "POR_timor_area_east_sunda"
				position = { x = 120 y = 22 }
				spriteType = "GFX_POR_timor_area_east_sunda"
				pdx_tooltip = "POR_timor_area_east_sunda_tt"
			}
			buttonType = {
				name = "POR_timor_area_west_timor"
				position = { x = 240 y = 86 }
				spriteType = "GFX_POR_timor_area_west_timor"
				pdx_tooltip = "POR_timor_area_west_timor_tt"
			}
			buttonType = {
				name = "POR_timor_area_east_timor"
				position = { x = 306 y = 58 }
				spriteType = "GFX_POR_timor_area_east_timor"
				pdx_tooltip = "POR_timor_area_east_timor_tt"
			}
			buttonType = {
				name = "POR_timor_area_oecusse"
				position = { x = 270 y = 92 }
				spriteType = "GFX_POR_timor_area_oecusse"
				pdx_tooltip = "POR_timor_area_oecusse_tt"
			}
		}

		instantTextboxType = {
			name = "POR_timor_influence_por_label"
			position = { x = 16 y = 208 }
			maxWidth = 214
			maxHeight = 18
			fixedsize = yes
			font = "hoi_16mbs"
			text = "POR_timor_influence_por_label_tt"
			format = left
			vertical_alignment = center
			alwaystransparent = yes
		}

		iconType = {
			name = "POR_timor_influence_por_bar"
			position = { x = 236 y = 209 }
			spriteType = "GFX_POR_timor_influence_bar_POR"
			pdx_tooltip = "POR_timor_influence_bar_tt"
		}

		instantTextboxType = {
			name = "POR_timor_influence_hol_label"
			position = { x = 16 y = 230 }
			maxWidth = 214
			maxHeight = 18
			fixedsize = yes
			font = "hoi_16mbs"
			text = "POR_timor_influence_hol_label_tt"
			format = left
			vertical_alignment = center
			alwaystransparent = yes
		}

		iconType = {
			name = "POR_timor_influence_hol_bar"
			position = { x = 236 y = 231 }
			spriteType = "GFX_POR_timor_influence_bar_HOL"
			pdx_tooltip = "POR_timor_influence_bar_tt"
		}

		instantTextboxType = {
			name = "POR_timor_influence_sphere"
			position = { x = 16 y = 252 }
			maxWidth = 454
			maxHeight = 32
			font = "hoi_16mbs"
			text = "POR_timor_influence_sphere_tt"
			format = left
			pdx_tooltip = "POR_timor_influence_sphere_tooltip"
		}
	}
