spriteTypes = {

###################################################
# EoaNB ship designer - module icon coverage.
#
# The engine resolves module icons as GFX_EMI_<name>, trying in order:
#   module key -> module gfx attribute -> module category.
# equipmentdesignermoduleicons.gfx declares everything as GFX_SMI_, which is
# never asked for, so every ship module fell through to the "?" icon.
#
# Every name appears exactly once here. Section order is precedence:
#   1. Per-module icons, tiered off the trailing number (engines off the tech
#      word: paddle / steam screw / steam turbine / oil turbine / diesel).
#      Where a module names its own unique art via gfx = ..., that art wins.
#   2. Category fallbacks, so modules added later still get art.
#   3. Remaining SMI entries mirrored under EMI.
#   4. Placeholders - no art drawn for these yet.
###################################################


	######## 1. Per-module icons (192)

	# ship_RML_battery
	spriteType = {
		name = "GFX_EMI_ship_RML_battery_1"
		textureFile = "gfx/interface/equipmentdesigner/naval/modules/icons/cannon_battery_icn_3.dds"
	}
	# ship_anti_air
