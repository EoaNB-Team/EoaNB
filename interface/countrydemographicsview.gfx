	# ---- population share bars ----
	# Driven by the "frame" property from the scripted gui. A progressbar is
	# cut into "steps" frames, so frame takes an integer 0-100, NOT the 0-1
	# fraction. The *_bar arrays in _eoanbsys_demographics_gui_effects.txt
	# do that conversion.
	progressbartype = {
		name = "GFX_eoanb_share_bar"
		textureFile1 = "gfx/interface/decisionview/decision_progress_good.dds"
		textureFile2 = "gfx/interface/decisionview/decision_progress_bg.dds"
		size = { x = 120 y = 14 }
		steps = 100
		effectFile = "gfx/FX/progress.lua"
		horizontal = yes
	}

