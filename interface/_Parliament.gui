##################################################################################################
#
#   EoaNB - Parliament interface
#
#   Layout
#   ------
#   parliament_window            summary panel, always on screen while parliament is open.
#                                Holds the seat arc, the support bar and the three tabs.
#   parliament_parties_window  ) the three tabbed content panels. Exactly one is visible at a
#   parliament_decision_window ) time, selected by the tab buttons in parliament_window and
#   parliament_reform_window   ) driven by show_parties_window / show_decisions_window /
#                                show_reform_window in common/scripted_guis/_Parliament_scripted_gui.txt
#
#   Every container and element name used by the scripted GUI is kept stable; see that file for
#   the effects, triggers and dynamic lists bound to the names below.
#
##################################################################################################

@panel_width  = 700
@panel_left   = 0

guiTypes = {

	# Topbar button that toggles the whole parliament view.
	containerWindowType = {
		name = "open_parliament_window"
		position = { x = 480 y = 7 }
		size = { width = 100 height = 100 }

		buttonType = {
			name = "open_button"
			spriteType = "GFX_parliament_circle_button"
			position = { x = -80 y = 7 }
			buttonFont = "hoi_18mbs"
			pdx_tooltip = "OPEN_PARLIAMENT_WINDOW_TT"
			clicksound = click_default
		}
	}

	# One seat in the arc. Positioned and coloured per entry by the scripted GUI
	# (properties parliament_dot_icon x / y / frame).
	containerWindowType = {
		name = "internal_politics_house_seat"
		position = { x = 0 y = 0 }

		iconType = {
			name = "parliament_dot_icon"
			quadTextureSprite = "GFX_internal_politics_party_colors"
		}
	}

	# One row in the government party list.
	containerWindowType = {
		name = "internal_politics_parties_gov"
		position = { x = 0 y = 0 }
		size = { width = 296 height = 22 }

		instantTextboxType = {
			name = "party_name_gov_txt"
			position = { x = 0 y = 2 }
			font = "hoi_16mbs"
			text = "internal_politics_party_name_gov"
			maxWidth = 292
			maxHeight = 20
			format = left
			pdx_tooltip = "parliament_coalition_loyalty_tt"
		}
	}

	# One row in the opposition party list.
	containerWindowType = {
		name = "internal_politics_parties_opp"
		position = { x = 0 y = 0 }
		size = { width = 296 height = 22 }

		instantTextboxType = {
			name = "party_name_opp_txt"
			position = { x = 0 y = 2 }
			font = "hoi_16mbs"
			text = "internal_politics_party_name_opp"
			maxWidth = 292
			maxHeight = 20
			format = left
			pdx_tooltip = "parliament_government_support_opp_tt"
		}
	}

	# One row in the unorganised party list.
	containerWindowType = {
		name = "internal_politics_parties_uno"
		position = { x = 0 y = 0 }
		size = { width = 638 height = 22 }

		instantTextboxType = {
			name = "party_name_uno_txt"
			position = { x = 0 y = 2 }
			font = "hoi_16mbs"
			text = "internal_politics_party_name_uno"
			maxWidth = 634
			maxHeight = 20
			format = left
			pdx_tooltip = "parliament_party_uno_tt"
		}
	}

	# One row in the neutral party list.
	containerWindowType = {
		name = "internal_politics_parties_neu"
		position = { x = 0 y = 0 }
		size = { width = 296 height = 22 }

		instantTextboxType = {
			name = "party_name_neu_txt"
			position = { x = 0 y = 2 }
			font = "hoi_16mbs"
			text = "internal_politics_party_name_neu"
			maxWidth = 292
			maxHeight = 20
			format = left
			pdx_tooltip = "parliament_government_support_neu_tt"
		}
	}

	# One row in the banned party list.
	containerWindowType = {
		name = "internal_politics_parties_ban"
		position = { x = 0 y = 0 }
		size = { width = 296 height = 22 }

		instantTextboxType = {
			name = "party_name_ban_txt"
			position = { x = 0 y = 2 }
			font = "hoi_16mbs"
			text = "internal_politics_party_name_ban"
			maxWidth = 292
			maxHeight = 20
			format = left
			pdx_tooltip = "parliament_party_ban_tt"
		}
	}

	##############################################################################################
	#   SUMMARY PANEL - seat arc, government support, tabs
	##############################################################################################
	containerWindowType = {
		name = "parliament_window"
		position = { x = -@panel_width y = 100 }
		show_position = { x = @panel_left y = 100 }
		size = { width = @panel_width height = 432 }

		show_animation_type = decelerated
		hide_animation_type = accelerated
		animation_time = 300
		show_sound = menu_open_window
		hide_sound = menu_close_window

		background = {
			name = "background"
			quadTextureSprite = "GFX_tiled_window2_1b_border"
		}

		iconType = {
			name = "header_bg"
			position = { x = 4 y = 3 }
			spriteType = "GFX_header_bg_large"
			alwaystransparent = yes
		}
		instantTextBoxType = {
			name = "title"
			position = { x = 54 y = 6 }
			font = "vic_36s"
			format = left
			text = "PARLIAMENT_WINDOW_TITLE"
			maxWidth = 500
			multiline = no
			alwaystransparent = yes
		}
		buttonType = {
			name = "close_button"
			spriteType = "GFX_closebutton"
			position = { x = -53 y = 6 }
			orientation = upper_right
			pdx_tooltip = "DIPLOMACY_CLOSE"
			clicksound = click_close
			shortcut = "ESCAPE"
		}
		iconType = {
			name = "separator_line_top"
			spriteType = "GFX_parliament_window_separator_line"
			position = { x = 45 y = 44 }
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "status_of_government"
			position = { x = 0 y = 48 }
			font = "vic_36s"
			format = center
			text = "STATUS_OF_GOVERNMENT"
			maxWidth = @panel_width
			multiline = no
			alwaystransparent = yes
		}

		# The arc is drawn from global.internal_politics_house_x / _y, which are absolute
		# offsets from this gridbox's origin. Keep this anchor 700 wide and keep the gridbox at
		# 120/120 - moving either one moves the whole chamber.
		containerWindowType = {
			name = "parliament_diagram_anchor"
			position = { x = 0 y = -40 }
			size = { width = 700 height = 260 }

			gridboxtype = {
				name = "parliament_diagram"
				position = { x = 120 y = 120 }
				size = { width = 100%% height = 100%% }
				slotsize = { width = 100%% height = 0 }
				max_slots_horizontal = 1
				add_horizontal = no
			}
		}

		instantTextBoxType = {
			name = "coalition_support_text"
			position = { x = 0 y = 266 }
			font = "hoi_24header"
			format = center
			text = "COALITION_SUPPORT"
			maxWidth = @panel_width
			multiline = no
			alwaystransparent = yes
		}

		# Fill is driven by parliament_support_percent (0-100) via properties.
		iconType = {
			name = "parliament_support_bar"
			position = { x = 183 y = 300 }
			spriteType = "GFX_parliament_support_bar"
			pdx_tooltip = "PARLIAMENT_SUPPORT_BAR_TT"
		}
		iconType = {
			name = "parliament_majority_marker"
			position = { x = 352 y = 296 }
			spriteType = "GFX_parliament_majority_marker"
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "parliament_majority_text"
			position = { x = 0 y = 320 }
			font = "hoi_16mbs"
			format = center
			text = "PARLIAMENT_MAJORITY_LINE"
			maxWidth = @panel_width
			multiline = no
			alwaystransparent = yes
		}
		instantTextBoxType = {
			name = "parliament_legitimacy_text"
			position = { x = 0 y = 342 }
			font = "hoi_16mbs"
			format = center
			text = "PARLIAMENT_LEGITIMACY_LINE"
			maxWidth = @panel_width
			multiline = no
			alwaystransparent = yes
		}

		iconType = {
			name = "separator_line_tabs"
			spriteType = "GFX_parliament_window_separator_line"
			position = { x = 45 y = 366 }
			alwaystransparent = yes
		}

		# Tabs. frame 1 = inactive, frame 2 = active; set from properties.
		buttonType = {
			name = "parties_button"
			position = { x = 50 y = 372 }
			quadTextureSprite = "GFX_parliament_tab_button"
			frame = 1
			buttonText = "PARTIES_TEXT"
			buttonFont = "hoi_18mbs"
			clicksound = click_default
			pdx_tooltip = "PARLIAMENT_TAB_PARTIES_TT"
		}
		buttonType = {
			name = "decision_button"
			position = { x = 254 y = 372 }
			quadTextureSprite = "GFX_parliament_tab_button"
			frame = 1
			buttonText = "DECISION_TEXT"
			buttonFont = "hoi_18mbs"
			clicksound = click_default
			pdx_tooltip = "PARLIAMENT_TAB_DECISIONS_TT"
		}
		buttonType = {
			name = "reform_button"
			position = { x = 458 y = 372 }
			quadTextureSprite = "GFX_parliament_tab_button"
			frame = 1
			buttonText = "REFORM_TEXT"
			buttonFont = "hoi_18mbs"
			clicksound = click_default
			pdx_tooltip = "PARLIAMENT_TAB_REFORMS_TT"
		}
	}

	##############################################################################################
	#   TAB 1 - PARTIES
	##############################################################################################
	containerWindowType = {
		name = "parliament_parties_window"
		position = { x = -@panel_width y = 528 }
		show_position = { x = @panel_left y = 528 }
		size = { width = @panel_width height = 505 }

		show_animation_type = decelerated
		hide_animation_type = accelerated
		animation_time = 300

		background = {
			name = "background"
			quadTextureSprite = "GFX_tiled_window2_1b_border"
		}

		iconType = {
			name = "header_bg"
			position = { x = 10 y = 6 }
			spriteType = "GFX_header_bg_large"
			alwaystransparent = yes
		}
		instantTextBoxType = {
			name = "title"
			position = { x = 60 y = 10 }
			font = "vic_36s"
			format = left
			text = "LIST_OF_PARTIES"
			maxWidth = 500
			multiline = no
			alwaystransparent = yes
		}

		containerWindowType = {
			name = "eoanb_internal_politics_parties_container_gov"
			position = { x = 16 y = 52 }
			size = { width = 326 height = 160 }
			clipping = yes

			background = {
				name = "background"
				quadTextureSprite = "GFX_tiled_paper_bg"
			}

			instantTextBoxType = {
				name = "government_parties"
				position = { x = 0 y = 8 }
				font = "hoi_18mbs"
				format = center
				text = "GOVERNMENT_PARTIES"
				maxWidth = 326
				multiline = no
				alwaystransparent = yes
			}

			containerWindowType = {
				name = "eoanb_internal_politics_parties_grid_gov"
				position = { x = 0 y = 0 }
				size = { width = 326 height = 160 }
				clipping = yes
				verticalScrollbar = "right_vertical_slider"
				scroll_wheel_factor = 22
				smooth_scrolling = yes
				margin = { top = 34 bottom = 6 }

				gridboxtype = {
					name = "parliament_parties_government"
					position = { x = 14 y = 0 }
					size = { width = 100%% height = 100%% }
					slotsize = { width = 296 height = 22 }
					max_slots_horizontal = 1
					add_horizontal = no
				}
			}
		}

		containerWindowType = {
			name = "eoanb_internal_politics_parties_container_opp"
			position = { x = 358 y = 52 }
			size = { width = 326 height = 160 }
			clipping = yes

			background = {
				name = "background"
				quadTextureSprite = "GFX_tiled_paper_bg"
			}

			instantTextBoxType = {
				name = "opposition_parties"
				position = { x = 0 y = 8 }
				font = "hoi_18mbs"
				format = center
				text = "OPPOSITION_PARTIES"
				maxWidth = 326
				multiline = no
				alwaystransparent = yes
			}

			containerWindowType = {
				name = "eoanb_internal_politics_parties_grid_opp"
				position = { x = 0 y = 0 }
				size = { width = 326 height = 160 }
				clipping = yes
				verticalScrollbar = "right_vertical_slider"
				scroll_wheel_factor = 22
				smooth_scrolling = yes
				margin = { top = 34 bottom = 6 }

				gridboxtype = {
					name = "parliament_parties_opposition"
					position = { x = 14 y = 0 }
					size = { width = 100%% height = 100%% }
					slotsize = { width = 296 height = 22 }
					max_slots_horizontal = 1
					add_horizontal = no
				}
			}
		}

	}

	# Hidden entirely when there is nothing to list - see parliament_parties_unorganized_window in the scripted GUI.
	containerWindowType = {
		name = "parliament_parties_unorganized_window"
		position = { x = -720 y = 748 }
		show_position = { x = 16 y = 748 }
		size = { width = 668 height = 132 }
		clipping = yes

		show_animation_type = decelerated
		hide_animation_type = accelerated
		animation_time = 300

		background = {
			name = "background"
			quadTextureSprite = "GFX_tiled_paper_bg"
		}

		instantTextBoxType = {
			name = "uno_parties"
			position = { x = 0 y = 8 }
			font = "hoi_18mbs"
			format = center
			text = "UNORGANIZED_PARTIES"
			maxWidth = 668
			multiline = no
			alwaystransparent = yes
		}

		containerWindowType = {
			name = "eoanb_internal_politics_parties_grid_uno"
			position = { x = 0 y = 0 }
			size = { width = 668 height = 132 }
			clipping = yes
			verticalScrollbar = "right_vertical_slider"
			scroll_wheel_factor = 22
			smooth_scrolling = yes
			margin = { top = 34 bottom = 6 }

			gridboxtype = {
