				add_horizontal = no
			}
		}
	}

	# Hidden entirely when there is nothing to list - see parliament_parties_neutral_window in the scripted GUI.
	containerWindowType = {
		name = "parliament_parties_neutral_window"
		position = { x = -720 y = 888 }
		show_position = { x = 16 y = 888 }
		size = { width = 326 height = 124 }
		clipping = yes

		show_animation_type = decelerated
		hide_animation_type = accelerated
		animation_time = 300

		background = {
			name = "background"
			quadTextureSprite = "GFX_tiled_paper_bg"
		}

		instantTextBoxType = {
			name = "neutral_parties"
			position = { x = 0 y = 8 }
			font = "hoi_18mbs"
			format = center
			text = "NEUTRAL_PARTIES"
			maxWidth = 326
			multiline = no
			alwaystransparent = yes
		}

		containerWindowType = {
			name = "eoanb_internal_politics_parties_grid_neu"
			position = { x = 0 y = 0 }
			size = { width = 326 height = 124 }
			clipping = yes
			verticalScrollbar = "right_vertical_slider"
			scroll_wheel_factor = 22
			smooth_scrolling = yes
			margin = { top = 34 bottom = 6 }

			gridboxtype = {
				name = "parliament_parties_neutral"
				position = { x = 14 y = 0 }
				size = { width = 100%% height = 100%% }
				slotsize = { width = 296 height = 22 }
				max_slots_horizontal = 1
				add_horizontal = no
			}
		}
	}

	# Hidden entirely when there is nothing to list - see parliament_parties_banned_window in the scripted GUI.
	containerWindowType = {
		name = "parliament_parties_banned_window"
		position = { x = -720 y = 888 }
		show_position = { x = 358 y = 888 }
		size = { width = 326 height = 124 }
		clipping = yes

		show_animation_type = decelerated
		hide_animation_type = accelerated
		animation_time = 300

		background = {
			name = "background"
			quadTextureSprite = "GFX_tiled_paper_bg"
		}

		instantTextBoxType = {
			name = "ban_parties"
			position = { x = 0 y = 8 }
			font = "hoi_18mbs"
			format = center
			text = "BANNED_PARTIES"
			maxWidth = 326
			multiline = no
			alwaystransparent = yes
		}

		containerWindowType = {
			name = "eoanb_internal_politics_parties_grid_ban"
			position = { x = 0 y = 0 }
			size = { width = 326 height = 124 }
			clipping = yes
			verticalScrollbar = "right_vertical_slider"
			scroll_wheel_factor = 22
			smooth_scrolling = yes
			margin = { top = 34 bottom = 6 }

			gridboxtype = {
				name = "parliament_parties_banned"
				position = { x = 14 y = 0 }
				size = { width = 100%% height = 100%% }
				slotsize = { width = 296 height = 22 }
				max_slots_horizontal = 1
				add_horizontal = no
			}
		}
	}

	##############################################################################################
	#   TAB 2 - DECISIONS
	##############################################################################################
	containerWindowType = {
		name = "parliament_decision_window"
		position = { x = -@panel_width y = 528 }
		show_position = { x = @panel_left y = 528 }
		size = { width = @panel_width height = 505 }

		show_animation_type = decelerated
		hide_animation_type = accelerated
		animation_time = 300

		background = {
			name = "background"
			quadTextureSprite = "GFX_tiled_window2_1b_border"
		}

		iconType = {
			name = "header_bg"
			position = { x = 10 y = 6 }
			spriteType = "GFX_header_bg_large"
			alwaystransparent = yes
		}
		instantTextBoxType = {
			name = "title"
			position = { x = 60 y = 10 }
			font = "vic_36s"
			format = left
			text = "DECISION_WINDOW_TITLE"
			maxWidth = 500
			multiline = no
			alwaystransparent = yes
		}
		instantTextBoxType = {
			name = "decision_hint"
			position = { x = -20 y = 18 }
			font = "hoi_16mbs"
			format = right
			orientation = upper_right
			text = "PARLIAMENT_DECISION_HINT"
			maxWidth = 380
			multiline = no
			alwaystransparent = yes
		}
	}

	# Normal decision list (no vote in progress).
	containerWindowType = {
		name = "parliament_decisions_conatiner_grid_1"
		position = { x = -@panel_width y = 574 }
		show_position = { x = 39 y = 574 }
		size = { width = 622 height = 450 }
		clipping = yes
		verticalScrollbar = "right_vertical_slider"
		scroll_wheel_factor = 44
		smooth_scrolling = yes
		margin = { top = 4 bottom = 10 }

		show_animation_type = decelerated
		hide_animation_type = accelerated
		animation_time = 300

		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_window_transparent"
		}

		containerWindowType = {
			name = "parliament_decisions_container_grid"
			position = { x = 0 y = 0 }
			size = { width = 100%% height = 100%% }

			gridboxtype = {
