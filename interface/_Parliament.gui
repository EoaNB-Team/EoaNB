				position = { x = 0 y = 0 }
				size = { width = 100%% height = 100%% }
				slotsize = { width = 600 height = 44 }
				max_slots_horizontal = 1
				add_horizontal = no
			}
		}
	}

	# Voting list, shown while a parliamentary vote is running.
	containerWindowType = {
		name = "parliament_decisions_conatiner_grid_2"
		position = { x = -@panel_width y = 574 }
		show_position = { x = 39 y = 574 }
		size = { width = 622 height = 450 }
		clipping = yes
		verticalScrollbar = "right_vertical_slider"
