				position = { x = 0 y = 0 }
				size = { width = 100%% height = 100%% }
				slotsize = { width = 600 height = 44 }
				max_slots_horizontal = 1
				add_horizontal = no
			}
		}
	}

	# One decision row. 600x44; the three background icons are swapped by the scripted GUI.
	containerWindowType = {
		name = "parliament_decision_container"
		position = { x = 0 y = 0 }
		size = { width = 600 height = 44 }

		iconType = {
			name = "parliament_decision_background_unavailable"
			position = { x = 0 y = 0 }
			spriteType = "GFX_parliament_decision_background_unavailable"
			alwaystransparent = yes
		}
		iconType = {
			name = "parliament_decision_background_available"
			position = { x = 0 y = 0 }
			spriteType = "GFX_parliament_decision_background_available"
			alwaystransparent = yes
		}
		iconType = {
			name = "parliament_decision_background_in_progress"
			position = { x = 0 y = 0 }
			spriteType = "GFX_parliament_decision_background_in_progress"
			alwaystransparent = yes
		}

		iconType = {
			name = "parliament_decision_icon"
			position = { x = 30 y = 19 }
			spriteType = "GFX_decision_unknown"
			centerposition = yes
			alwaystransparent = yes
		}
		instantTextboxType = {
			name = "parliament_decision_name"
